{
  "fonts": {
    "display": "\"DM Sans\", ui-sans-serif, system-ui, sans-serif",
    "label": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "label_file": "fonts/JetBrainsMono-500.woff2",
    "files": "assets/fonts/ (DM Sans 500/700 and JetBrains Mono 500, OFL; from npm pack @fontsource/dm-sans@5.1.0 and @fontsource/jetbrains-mono@5.1.0, latin subsets)"
  },
  "colors": {
    "cyan": "#0AF0F0",
    "amber": "#FFB904",
    "magenta": "#CD00EE",
    "white": "#FFFFFF",
    "ink": "#0B0C10",
    "dim": "rgba(255,255,255,0.38)",
    "dim_light": "rgba(11,12,16,0.32)"
  },
  "backgrounds": {
    "blue": "radial-gradient(ellipse at 70% 85%, rgba(205,0,238,0.35), transparent 55%), linear-gradient(160deg, #2A35D6 0%, #1B23B8 60%, #141A8F 100%)",
    "black": "radial-gradient(ellipse at 55% 70%, rgba(42,53,214,0.45), transparent 60%), #050608",
    "light": "radial-gradient(circle, rgba(11,12,16,0.10) 1.5px, transparent 1.6px) 0 0 / 36px 36px, #F2F3F7"
  },
  "text_on": {
    "blue": "#FFFFFF",
    "black": "#FFFFFF",
    "light": "#0B0C10"
  },
  "highlight": {
    "fill": "#FFE7A3",
    "text": "#0B0C10",
    "handle": "#FFFFFF",
    "handle_border": "#0B0C10"
  },
  "motion": {
    "enter_ease": "power3.out",
    "exit_ease": "power2.in",
    "enter": 0.42,
    "exit": 0.28,
    "stagger_total_max": 0.5
  },
  "ambient": {
    "orb_opacity": {
      "blue": 0.9,
      "black": 0.8,
      "light": 0.4
    },
    "orbs": [
      "rgba(10,240,240,0.30)",
      "rgba(205,0,238,0.34)",
      "rgba(42,53,214,0.55)"
    ],
    "push": 1.045,
    "drift_every": 5.0
  }
}
