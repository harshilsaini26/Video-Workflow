{
  "fonts": {
    "display": "\"DM Sans\", ui-sans-serif, system-ui, sans-serif",
    "label": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "label_file": "fonts/JetBrainsMono-500.woff2",
    "files": "assets/fonts/ (DM Sans 500/700 and JetBrains Mono 500, OFL; from npm pack @fontsource/dm-sans@5.1.0 and @fontsource/jetbrains-mono@5.1.0, latin subsets)"
  },
  "palette": {
    "rosewater": "#dc8a78",
    "flamingo": "#dd7878",
    "pink": "#ea76cb",
    "mauve": "#8839ef",
    "red": "#d20f39",
    "maroon": "#e64553",
    "peach": "#fe640b",
    "yellow": "#df8e1d",
    "green": "#40a02b",
    "teal": "#179299",
    "sky": "#04a5e5",
    "sapphire": "#209fb5",
    "blue": "#1e66f5",
    "lavender": "#7287fd",
    "text": "#4c4f69",
    "subtext1": "#5c5f77",
    "subtext0": "#6c6f85",
    "overlay2": "#7c7f93",
    "overlay1": "#8c8fa1",
    "overlay0": "#9ca0b0",
    "surface2": "#acb0be",
    "surface1": "#bcc0cc",
    "surface0": "#ccd0da",
    "base": "#eff1f5",
    "mantle": "#e6e9ef",
    "crust": "#dce0e8"
  },
  "palette_source": "Catppuccin Latte, github.com/catppuccin/palette palette.json (MIT)",
  "backgrounds": {
    "mantle": {
      "fill": "mantle",
      "card": "base",
      "card_line": "surface0"
    },
    "base": {
      "fill": "base",
      "card": "base",
      "card_line": "surface0"
    }
  },
  "roles": {
    "ink": "text",
    "dim": "subtext0",
    "muted": "overlay2",
    "line": "surface1",
    "accent": "blue",
    "on_accent": "base",
    "accent2": "mauve",
    "good": "green",
    "bad": "red",
    "warn": "peach",
    "chrome": "crust"
  },
  "series": [
    [
      "blue",
      "base"
    ],
    [
      "mauve",
      "base"
    ],
    [
      "teal",
      "base"
    ],
    [
      "yellow",
      "text"
    ],
    [
      "red",
      "base"
    ]
  ],
  "shadow": {
    "color": "text",
    "card": "0 18px 44px %s",
    "alpha": 0.14
  },
  "highlight": {
    "fill": "blue",
    "text": "base",
    "handle": "base",
    "handle_border": "blue"
  },
  "motion": {
    "enter_ease": "power3.out",
    "exit_ease": "power3.in",
    "enter": 0.42,
    "exit": 0.28,
    "stagger_total_max": 0.5
  },
  "ambient": {
    "glows": {
      "mantle": [
        {
          "color": "lavender",
          "alpha": 0.16,
          "size": 1200,
          "at": [
            900,
            1550
          ]
        },
        {
          "color": "sky",
          "alpha": 0.1,
          "size": 1000,
          "at": [
            120,
            1150
          ]
        },
        {
          "color": "lavender",
          "alpha": 0.08,
          "size": 900,
          "at": [
            700,
            220
          ]
        }
      ],
      "base": [
        {
          "color": "sky",
          "alpha": 0.12,
          "size": 1100,
          "at": [
            160,
            1500
          ]
        },
        {
          "color": "lavender",
          "alpha": 0.12,
          "size": 1000,
          "at": [
            920,
            1100
          ]
        },
        {
          "color": "sky",
          "alpha": 0.06,
          "size": 900,
          "at": [
            540,
            260
          ]
        }
      ]
    },
    "shift": {
      "x": 380,
      "y": 420,
      "duration": 1.2
    }
  }
}
